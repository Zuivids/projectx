# Copy to .env (never commit .env) and choose your own local passwords.
DB_URL=jdbc:mariadb://localhost:3306/lms
DB_USERNAME=lms_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# AES-256 key for encrypting MFA secrets: 32 random bytes, base64-encoded.
# Not needed with the "local" profile, which has its own development key.
# Generate one for staging/production with: openssl rand -base64 32
# Losing this key means every user must set up MFA again, so store it in a secret manager.
MFA_ENCRYPTION_KEY=

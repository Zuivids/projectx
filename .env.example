# Local settings. dev-start.bat / dev-start.sh create .env from this with random passwords on the first run.
# Never commit .env.

# Database (Docker container "projectx-mariadb"; DBeaver: localhost:3306, database "lms")
DB_URL=jdbc:mariadb://localhost:3306/lms
DB_USERNAME=lms_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Local super admin, created automatically by the "local" profile
LOCAL_ADMIN_EMAIL=admin@projectx.test
LOCAL_ADMIN_PASSWORD=change-me-please

# AES-256 key for encrypting MFA secrets: 32 random bytes, base64-encoded.
# Not needed locally (the "local" profile has its own development key).
# Generate one for staging/production with: openssl rand -base64 32
# Losing this key means every user must set up MFA again, so store it in a secret manager.
MFA_ENCRYPTION_KEY=
